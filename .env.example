NODE_ENV=development
HOST=127.0.0.1
PORT=4000
INTEGRATIONS_MODE=mock
CORS_ORIGIN=http://localhost:3000
# All three backends use the same Atlas database. Put actual credentials only in .env.
# Phase 1 identity/session persistence uses this database; run the admin migration first.
MONGODB_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@inventorycluster.flnec0d.mongodb.net/hire_me?retryWrites=true&w=majority&appName=daily_life
MONGODB_DB_NAME=hire_me


# Run admin-panel/backend auth:setup to generate private keys in each backend .env.
AUTH_ENABLED=false
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_RESEND_SECONDS=60
AUTH_LIMIT_WINDOW_SECONDS=600
AUTH_PHONE_LIMIT=5
AUTH_IP_LIMIT=20
AUTH_ADMIN_LOGIN_LIMIT=10

# Dedicated local Compose ports; auth runtime may continue using Atlas.
MONGO_PORT=27018
REDIS_PORT=6380

# Phase 2: run admin backend phase2:setup to generate/preserve private shared data keyring.
PHASE2_ENABLED=false
PHASE2_ACTIVE_KEY_ID=v1
PHASE2_DATA_KEYS={}
PHASE2_NOTICE_VERSION=development-2026-10-10
# Development expiry/contact controls, not legal retention periods.
PHASE2_CASE_DAYS=14
PHASE2_CONSENT_DAYS=30
PHASE2_CONTACT_ATTEMPTS=3
PHASE2_MFA_SECONDS=600
PHASE2_REQUEST_LIMIT=5
